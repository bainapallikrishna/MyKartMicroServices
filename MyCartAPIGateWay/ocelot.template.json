{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/Auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "${UserHost}",
          "Port": ${UserPort}
        }
      ],
      "UpstreamPathTemplate": "/user/api/Auth/{everything}",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/UserMicroservices",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "${UserHost}",
          "Port": ${UserPort}
        }
      ],
      "UpstreamPathTemplate": "/user/api/UserMicroservices",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "${CategoryHost}",
          "Port": ${CategoryPort}
        }
      ],
      "UpstreamPathTemplate": "/category/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "SwaggerKey": "CategoryService"
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "${ProductHost}",
          "Port": ${ProductPort}
        }
      ],
      "UpstreamPathTemplate": "/product/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "SwaggerKey": "ProductService"
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "${UserHost}",
          "Port": ${UserPort}
        }
      ],
      "UpstreamPathTemplate": "/user/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "SwaggerKey": "UserService"
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "${PurchaseHost}",
          "Port": ${PurchasePort}
        }
      ],
      "UpstreamPathTemplate": "/purchase/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "SwaggerKey": "PurchaseService"
    }
  ],
  "SwaggerEndPoints": [
    {
      "Key": "CategoryService",
      "Config": [
        {
          "Name": "Category Service",
          "Version": "v1",
          "Url": "http://${CategoryHost}:${CategoryPort}/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "ProductService",
      "Config": [
        {
          "Name": "Product Service",
          "Version": "v1",
          "Url": "http://${ProductHost}:${ProductPort}/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "UserService",
      "Config": [
        {
          "Name": "User Service",
          "Version": "v1",
          "Url": "http://${UserHost}:${UserPort}/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "PurchaseService",
      "Config": [
        {
          "Name": "Purchase Service",
          "Version": "v1",
          "Url": "http://${PurchaseHost}:${PurchasePort}/swagger/v1/swagger.json"
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "${GatewayBaseUrl}"
  }
}
